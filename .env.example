# Copy to .env for local dev. Vite bakes the VITE_* values into the SPA, and the
# Cloudflare plugin hands the whole file to the Worker (overriding wrangler.jsonc vars).

# Local Supabase (`supabase start` prints both; ports are 5532x so this runs alongside lo30)
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=*****

# Worker only: low-stock emails via Maileroo (worker/low-stock.ts). Leave blank locally and
# the notify endpoint answers 503 "not configured" — the in-app banner still works.
# In production set the two keys as Worker *secrets*:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler secret put MAILEROO_API_KEY
# and ALERT_FROM_EMAIL in wrangler.jsonc `vars`, on a domain verified in Maileroo.
SUPABASE_SERVICE_ROLE_KEY=
MAILEROO_API_KEY=
ALERT_FROM_EMAIL=Home Bar <bar@yourdomain.com>
