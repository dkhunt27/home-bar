{
  "name": "home-bar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Home Bar Stock: a mobile-first tracker for a Bartesian capsule cabinet",
  "scripts": {
    "add-owner": "node tools/add-owner.mjs",
    "build": "tsc -b && vite build",
    "build:prod": "node tools/build-prod.mjs",
    "deploy:manual:web": "npm run build:prod && wrangler deploy",
    "dev": "vite",
    "gen:catalog": "node tools/gen-catalog-migration.mjs",
    "gen:collections": "node tools/gen-collections-migration.mjs",
    "gen:pwa-icons": "node tools/gen-pwa-icons.mjs",
    "gen:types": "supabase gen types typescript > src/types/database.gen.ts",
    "gen:worker-types": "wrangler types",
    "lint": "tsc -b && biome check .",
    "lint:fix": "biome check --write .",
    "preview": "npm run build && wrangler dev",
    "push:prod": "supabase db push --remote",
    "reset:local": "supabase db reset && npm run gen:types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "jsonc-parser": "^3.3.1",
    "sharp": "^0.35.4",
    "supabase": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "uqr": "^0.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "workerd@1.20261113.1": true
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  }
}
